{
  "name": "turnout-picker",
  "productName": "Turnout Picker",
  "version": "0.1.0",
  "description": "Turnout browser picker (GPL-3.0)",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./picker.css -o ./picker-built.css -m",
    "prestart": "npm run build:css",
    "start": "node run-electron.mjs",
    "lint": "node --check main.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build:css && node scripts/package-macos-app.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "file-icon": "^5.1.1",
    "js-yaml": "^4.1.0",
    "tldts": "^6.1.0"
  }
}
